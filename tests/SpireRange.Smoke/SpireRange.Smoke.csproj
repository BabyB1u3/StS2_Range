<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Slay the Spire 2</GameDir>
    <GameDataDir>$(GameDir)\data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SpireRange/SpireRange.csproj" />
    <Reference Include="sts2" HintPath="$(GameDataDir)\sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(GameDataDir)\GodotSharp.dll" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)\0Harmony.dll" />
  </ItemGroup>
</Project>
